<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="fw-bold m-0"><%= @year %> Reading Analytics</h1>
    <%= link_to "← Back to Planner", book_planner_path(year: @year), class: "fw-bold text-decoration-none small table-link" %>
  </div>
  <%= form_tag book_analytics_path, method: :get, class: "d-flex gap-2 align-items-center" do %>
    <%= select_year @year, prefix: nil, field_name: "year", start_year: @year - 1, end_year: @year + 5, class: "form-select form-select-sm w-auto" %>
    <%= submit_tag "Change Year", class: "theme-btn btn-sm text-nowrap" %>
  <% end %>
</div>

<%# Top Key Metrics %>
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div class="stat-value"><%= @books_finished %></div>
      <div class="stat-label">Books Finished</div>
      <% if @yearly_goal %>
        <div class="small text-normal mt-1">of <%= @yearly_goal.target_books %> goal</div>
      <% end %>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div class="stat-value"><%= @total_pages_read %></div>
      <div class="stat-label">Pages Read</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div class="stat-value"><%= @avg_days_per_book %></div>
      <div class="stat-label">Avg Days per Book</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div class="stat-value"><%= @monthly_data.sum { |m| m[:pages] } %></div>
      <div class="stat-label">Total Pages</div>
    </div>
  </div>
</div>

<%# Monthly Breakdown %>
<div class="card card-box mb-4">
  <h2 class="h5 fw-bold mb-3">Monthly Breakdown</h2>
  <div class="row g-3">
    <% @monthly_data.each do |data| %>
      <% if data[:count] > 0 %>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <div class="month-card has-books">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="fw-bold small" style="color: var(--btn-bg);"><%= Date::MONTHNAMES[data[:month]] %></span>
              <span class="badge rounded-pill bg-light text-dark border"><%= data[:count] %> book<%= "s" unless data[:count] == 1 %> · <%= data[:pages] %>p</span>
            </div>
            <% data[:books].each do |book| %>
              <div class="d-flex gap-2 align-items-center pt-2 border-top">
                <% if book.cover_url.present? %>
                  <img src="<%= book.cover_url %>" alt="<%= book.title %>" class="analytics-cover shadow-sm">
                <% else %>
                  <div class="analytics-cover bg-secondary"></div>
                <% end %>
                <div class="overflow-hidden">
                  <div class="fw-semibold text-truncate small"><%= book.title %></div>
                  <div class="small text-normal text-truncate" style="font-size: 0.75rem;"><%= book.author %></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <div class="month-card">
            <div class="fw-semibold small mb-1"><%= Date::MONTHNAMES[data[:month]] %></div>
            <div class="small text-normal">0 books · 0p</div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<%# By Genre %>
<% if @genre_data.any? %>
  <div class="card card-box">
    <h2 class="h5 fw-bold mb-3">By Genre</h2>
    <div class="row g-3">
      <% @genre_data.each do |genre, data| %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="month-card p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="fw-bold" style="color: var(--btn-bg);"><%= genre %></span>
              <span class="badge rounded-pill" style="background-color: var(--btn-bg);"><%= data[:count] %> book<%= "s" unless data[:count] == 1 %></span>
            </div>
            <% data[:books].each do |book| %>
              <div class="d-flex gap-3 align-items-center <%= "mb-2" unless book == data[:books].last %>">
                <% if book.cover_url.present? %>
                  <img src="<%= book.cover_url %>" alt="<%= book.title %>" class="analytics-cover shadow-sm">
                <% else %>
                  <div class="analytics-cover bg-secondary"></div>
                <% end %>
                <div>
                  <div class="fw-semibold small"><%= book.title %></div>
                  <div class="small text-normal"><%= book.author %><% if book.total_pages %> · <%= book.total_pages %>p<% end %></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
