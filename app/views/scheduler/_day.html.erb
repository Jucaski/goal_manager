<div class="d-flex align-items-center justify-content-between mb-3">
  <div class="d-flex align-items-center gap-2">
    <%= link_to scheduler_path(date: @date - 1.day, view: "day"), class: "theme-btn btn-sm text-decoration-none", data: { turbo_frame: "scheduler-view" } do %>
      <span class="material-symbols-outlined fs-6">chevron_left</span>
    <% end %>
    <h2 class="h4 fw-bold m-0"><%= @date.strftime("%A, %b %d") %></h2>
    <%= link_to scheduler_path(date: @date + 1.day, view: "day"), class: "theme-btn btn-sm text-decoration-none", data: { turbo_frame: "scheduler-view" } do %>
      <span class="material-symbols-outlined fs-6">chevron_right</span>
    <% end %>
    <%= link_to "Today", scheduler_path(date: Date.current, view: "day"), class: "btn btn-sm btn-outline-secondary", data: { turbo_frame: "scheduler-view" } %>
  </div>
</div>

<div class="card card-box">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="h5 fw-bold m-0">Day view</h3>
    <div class="small text-normal">
      <%= @schedules.size %> scheduled task<%= @schedules.size == 1 ? "" : "s" %>
    </div>
  </div>

  <% if @schedules.any? %>
    <div class="d-flex flex-column gap-2">
      <% @schedules.each do |task| %>
        <%
          running_log = task.active_time_log_for(@date)
          today_logs = task.time_logs_for(@date).where.not(ended_at: nil)
        %>
        <div class="card-item" data-scheduler-day-target="row" data-schedule-id="<%= task.id %>">
          <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <div class="min-w-0">
              <div class="fw-semibold">
                <%= task.title %>
                <% if task.tag.present? %>
                  <span class="badge text-bg-primary ms-1">#<%= task.tag %></span>
                <% end %>
              </div>
              <div class="small text-normal">
                <%= task.start_time.strftime("%H:%M") %> – <%= task.end_datetime(@date).strftime("%H:%M") %>
                <% if running_log %>
                  · <span class="text-success fw-semibold">running</span>
                <% elsif today_logs.any? %>
                  · <span class="fw-semibold">done · <%= today_logs.sum(&:duration_minutes) %> min</span>
                <% end %>
              </div>
            </div>
            <div class="text-nowrap">
              <% if running_log %>
                <%= button_to "Stop", stop_time_log_path(running_log), method: :patch, class: "theme-btn btn-sm", data: { turbo_frame: "scheduler-view" } %>
              <% else %>
                <%= button_to "Start", start_time_logs_path(task_id: task.id, date: @date), method: :post, class: "theme-btn btn-sm", data: { turbo_frame: "scheduler-view" } %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="small text-normal mb-0">No tasks scheduled for this day. <%= link_to "Create a template", new_task_template_path, class: "table-link" %> to add one.</p>
  <% end %>
</div>
