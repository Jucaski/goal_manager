<% content_for :title, "Ringtones" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="fw-bold m-0">Ringtones</h1>
  <%= link_to "Back to Schedule", scheduler_path, class: "text-decoration-none table-link" %>
</div>

<div class="card card-box mb-4">
  <h2 class="h5 fw-bold mb-3">Upload a tone</h2>
  <%= form_with model: @new_ringtone, multipart: true, class: "row g-3" do |f| %>
    <% if @new_ringtone.errors.any? %>
      <div class="col-12">
        <div class="alert alert-danger py-2 small mb-0">
          <ul class="mb-0 ps-3">
            <% @new_ringtone.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div class="col-12 col-md-4">
      <%= f.label :name, "Name", class: "form-label text-uppercase small fw-semibold" %>
      <%= f.text_field :name, class: "form-control", placeholder: "e.g. Morning chime" %>
    </div>

    <div class="col-12 col-md-4">
      <%= f.label :audio, "Audio file", class: "form-label text-uppercase small fw-semibold" %>
      <%= f.file_field :audio, accept: "audio/*", class: "form-control" %>
    </div>

    <div class="col-12 col-md-4 d-flex align-items-end">
      <%= f.submit "Upload", class: "theme-btn" %>
    </div>
  <% end %>
</div>

<div class="card card-box">
  <h2 class="h5 fw-bold mb-3">Your Ringtones</h2>
  <% if @ringtones.any? %>
    <div class="d-flex flex-column gap-2">
      <% @ringtones.each do |ringtone| %>
        <div class="card-item d-flex justify-content-between align-items-center">
          <div class="fw-semibold"><%= ringtone.name %></div>
          <div class="text-nowrap d-flex align-items-center gap-2">
            <audio controls preload="none" src="<%= ringtone.audio_url %>"></audio>
            <%= button_to "Delete", ringtone, method: :delete, data: { turbo_confirm: "Delete this ringtone?" }, class: "btn btn-sm btn-outline-danger" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="small text-normal mb-0">No ringtones yet. Upload an audio file above.</p>
  <% end %>
</div>
