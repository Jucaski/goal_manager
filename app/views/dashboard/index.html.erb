<% content_for :title, "Dashboard" %>

<h1 class="fw-bold mb-4">Dashboard</h1>

<%# Reading Stats %>
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div class="stat-value"><%= @books_finished %></div>
      <div class="stat-label">Books Finished</div>
      <div class="small text-normal mt-1"><%= Date::MONTHNAMES[@month] %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div class="stat-value"><%= "#{@pages_read}/#{@planned_pages}" %></div>
      <div class="stat-label">Pages Read / Planned</div>
      <div class="small text-normal mt-1"><%= Date::MONTHNAMES[@month] %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div class="stat-value"><%= @pages_per_day %></div>
      <div class="stat-label">Pages per Day</div>
      <div class="small text-normal mt-1"><%= Date::MONTHNAMES[@month] %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <div class="stat-value"><%= @books_left %></div>
      <div class="stat-label">Books Left This Month</div>
      <div class="small text-normal mt-1">of <%= @planned_books_count %> planned</div>
    </div>
  </div>
</div>

<%# Water intake %>
<div class="card card-box mb-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 fw-bold m-0">💧 Water</h2>
    <div class="small text-normal">
      Today: <span class="fw-bold text-primary"><%= @water_today %> ml</span>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-12 col-md-4">
      <div class="small text-uppercase fw-semibold text-normal mb-2">Add water</div>
      <%= form_with model: WaterEntry.new, url: water_entries_path, class: "d-flex gap-2" do |f| %>
        <%= f.number_field :amount_ml, min: 1, placeholder: "ml e.g. 250", class: "form-control form-control-sm", required: true %>
        <%= f.submit "Add", class: "theme-btn btn-sm" %>
      <% end %>

      <% if @water_today_entries.any? %>
        <div class="d-flex flex-column gap-1 mt-2">
          <% @water_today_entries.each do |entry| %>
            <div class="d-flex justify-content-between align-items-center">
              <span class="small"><%= entry.amount_ml %> ml</span>
              <%= button_to "×", water_entry_path(entry), method: :delete,
                            data: { turbo_confirm: "Remove this water entry?" },
                            class: "btn btn-sm btn-outline-danger py-0 px-1" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="col-12 col-md-4">
      <div class="small text-uppercase fw-semibold text-normal mb-2">This week</div>
      <% week_max = @water_week.values.max.to_f %>
      <% if @water_week.any? %>
        <div class="d-flex flex-column gap-2">
          <% (Date.current.beginning_of_week..Date.current.end_of_week).each do |day| %>
            <% ml = @water_week[day].to_i %>
            <div class="stat-bar-row">
              <span class="stat-bar-label"><%= day.strftime("%a") %></span>
              <div class="stat-bar-track">
                <div class="stat-bar-fill" style="width: <%= week_max.positive? ? (ml / week_max * 100).round : 0 %>%;"></div>
              </div>
              <span class="stat-bar-value"><%= ml %> ml</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="small text-normal mb-0">No water logged this week yet.</p>
      <% end %>
    </div>

    <div class="col-12 col-md-4">
      <div class="small text-uppercase fw-semibold text-normal mb-2">This month</div>
      <% month_max = @water_month.values.max.to_f %>
      <% if @water_month.any? %>
        <div class="d-flex flex-column gap-2" style="max-height: 220px; overflow-y: auto;">
          <% (@water_month.keys.min..@water_month.keys.max).each do |day| %>
            <% ml = @water_month[day].to_i %>
            <div class="stat-bar-row">
              <span class="stat-bar-label"><%= day.strftime("%b %d") %></span>
              <div class="stat-bar-track">
                <div class="stat-bar-fill" style="width: <%= month_max.positive? ? (ml / month_max * 100).round : 0 %>%;"></div>
              </div>
              <span class="stat-bar-value"><%= ml %> ml</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="small text-normal mb-0">No water logged this month yet.</p>
      <% end %>
    </div>
  </div>
</div>

<%# Current Goal counter %>
<% if @current_goal %>
  <div class="card card-box mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <div class="small text-uppercase fw-semibold text-normal">Current Goal</div>
        <h2 class="h5 fw-bold m-0 mt-1"><%= @current_goal.title %></h2>
      </div>
      <%= link_to "Manage →", counters_path, class: "fw-bold text-decoration-none table-link" %>
    </div>
    <div class="row g-3">
      <% @current_goal.units.each do |unit| %>
        <div class="col-6 col-md-3 col-lg-2">
          <div class="stat-card">
            <div class="stat-value"><%= @current_goal.value_for(unit) %></div>
            <div class="stat-label">
              <%= unit.titleize %>
              <%= @current_goal.direction == "descending" ? "left" : "elapsed" %>
            </div>
            <div class="small text-normal mt-1">of <%= @current_goal.total_value_for(unit) %></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>


<div class="container-fluid">
  <div class="row">
    <%# Flashcards summary per deck %>
    <% @decks_with_summary.select { |item| item[:cards_count] > 0 }.each do |item| %>
      <div class="col-md-6">
        <% deck = item[:deck] %>
        <div class="card card-box mb-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h2 class="h5 fw-bold m-0"><%= deck.name %></h2>
              <div class="small text-normal"><%= item[:cards_count] %> words · <%= item[:due_count] %> due now</div>
            </div>
            <div class="text-nowrap">
              <%= link_to "Summary →", summary_flashcard_deck_path(deck), class: "fw-bold text-decoration-none table-link" %>
              <%= link_to "Study", deck.writing? ? study_writing_flashcard_deck_path(deck) : study_flashcard_deck_path(deck), class: "theme-btn btn-sm text-decoration-none ms-2" %>
            </div>
          </div>

          <div class="row">
            <div class="row">
              <% FlashcardDecksHelper::PHASES.each do |phase| %>
                <div class="col-3">
                  <div class="stat-card">
                    <div class="stat-value"><%= item[:phase_counts][phase] %></div>
                    <div class="stat-label"><%= phase_label(phase) %></div>
                  </div>
                </div>
              <% end %>
            </div>

            <div class="row mt-3">
              <div class="col-12 col-lg-12">
                <% if item[:review_counts_by_day].any? %>
                  <%= render "flashcard_decks/heatmap", review_counts_by_day: item[:review_counts_by_day] %>
                <% else %>
                  <p class="small text-normal mb-0">No reviews yet. Study some cards to see activity.</p>
                <% end %>
              </div>
            </div>
          </div>
        </div>

      </div>
    <% end %>
  </div>
  <div class="row">
    <div class="col-md-6">
      <%# Day habits table %>
      <div class="card card-box">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h5 fw-bold m-0">Day Habits</h2>
          <%= link_to "View Habits →", day_habits_path, class: "fw-bold text-decoration-none table-link" %>
        </div>
        <div class="table-responsive" id="habits-table-wrapper">
          <table class="table table-hover table-bordered align-middle text-nowrap theme-table">
            <thead>
              <tr>
                <th scope="col" class="sticky-habit">Habit</th>
                <% @dates.each do |date| %>
                  <th scope="col" class="text-center <%= 'bg-table-active' if date == Date.current %>">
                    <%= date.day %>
                    <div class="small fw-normal opacity-75"><%= date.strftime("%b") %></div>
                  </th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% @habits.each do |habit| %>
                <tr>
                  <th scope="row" class="sticky-habit fw-normal"><%= habit.title %></th>
                  <% @dates.each do |date| %>
                    <% habit_ratings = @ratings_map[habit.id] %>
                    <% rating = habit_ratings && habit_ratings[date] ? habit_ratings[date].rating : '-' %>
                    <td class="text-center <%= 'table-active' if date == Date.current %>">
                      <%= rating %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="col-12 col-md-6">
      <%# Timers history calendar %>
      <div class="card card-box mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h5 fw-bold m-0">Timers History</h2>
          <%= link_to "View History →", history_path, class: "fw-bold text-decoration-none table-link" %>
        </div>
        <%= month_calendar(events: @sessions, start_on_sunday: true) do |date, sessions| %>
          <%= link_to history_path(date: date),
            data: { turbo_frame: "day_details" },
            class: "text-center d-block text-decoration-none" do %>
            <div>
              <%= date.day %>
              <% if sessions.present? %>
                <div class="text-green-600 text-xl">🏃🏼</div>
              <% end %>
            </div>
          <% end %>
        <% end %>

        <turbo-frame id="day_details" class="mt-4">
          <% if params[:date] %>
            <%= render "histories/day_sessions",
              date: Date.parse(params[:date]),
              sessions: @sessions.select { |s| s.date == Date.parse(params[:date]) } %>
          <% end %>
        </turbo-frame>
      </div>
    </div>

  </div>
</div>


<script>
  document.addEventListener("DOMContentLoaded", function() {
    const wrapper = document.getElementById("habits-table-wrapper");
    if (wrapper) wrapper.scrollLeft = wrapper.scrollWidth;
  });
</script>
