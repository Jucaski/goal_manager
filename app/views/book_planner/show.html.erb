<div class="flex justify-between items-center mb-4">
  <h1 class="text-2xl font-bold">Book Planner</h1>
  <%= link_to "Analytics", book_analytics_path(year: @year), class: "bg-blue-500 text-white px-3 py-1 rounded" %>
</div>

<%# Yearly Goal %>
<div class="border rounded p-4 mb-4">
  <h2 class="font-semibold mb-2">
    <%= @year %> Goal
    <% if @yearly_goal.persisted? %>
      <span class="text-sm text-gray-600 font-normal"> — <%= @yearly_goal.target_books %> books</span>
    <% end %>
  </h2>
  <% if @yearly_goal.persisted? %>
    <%= form_with model: @yearly_goal, class: "flex gap-2 items-end" do |f| %>
      <%= f.hidden_field :year, value: @year %>
      <div>
        <%= f.label :target_books, "Target", class: "text-sm" %>
        <%= f.number_field :target_books, value: @yearly_goal.target_books, min: 1, class: "form-control form-control-sm" %>
      </div>
      <%= f.submit "Update", class: "bg-blue-500 text-white px-3 py-1 rounded text-sm" %>
    <% end %>
  <% else %>
    <%= form_with model: @yearly_goal, class: "flex gap-2 items-end" do |f| %>
      <%= f.hidden_field :year, value: @year %>
      <div>
        <%= f.label :target_books, "Books to read in #{@year}", class: "text-sm" %>
        <%= f.number_field :target_books, min: 1, class: "form-control form-control-sm" %>
      </div>
      <%= f.submit "Set Goal", class: "bg-green-500 text-white px-3 py-1 rounded text-sm" %>
    <% end %>
  <% end %>
</div>

<%# Book Catalog %>
<div class="border rounded p-4 mb-4">
  <div class="flex justify-between items-center mb-2">
    <h2 class="font-semibold">Your Books</h2>
    <%= link_to "Add Book", new_book_path, class: "bg-green-500 text-white px-3 py-1 rounded text-sm" %>
  </div>
  <% if @books.any? %>
    <div class="space-y-2">
      <% @books.each do |book| %>
        <div class="flex justify-between items-center py-1 border-b last:border-b-0">
          <div>
            <span class="font-medium"><%= book.title %></span>
            <% if book.author.present? %>
              <span class="text-sm text-gray-600"> — <%= book.author %></span>
            <% end %>
            <span class="text-sm text-gray-500">
              <% if book.total_pages %><%= book.total_pages %>p · <% end %>
              <% if book.genre %><%= book.genre %><% end %>
            </span>
          </div>
          <div class="flex gap-2 items-center">
            <%= link_to "Edit", edit_book_path(book), class: "text-yellow-600 text-sm" %>
            <%= button_to "Delete", book, method: :delete, data: { turbo_confirm: "Remove #{book.title}?" }, class: "text-red-600 text-sm bg-transparent border-0" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-sm">No books yet. Add your first book!</p>
  <% end %>
</div>

<%# Monthly Plan %>
<div class="border rounded p-4 mb-4">
  <div class="flex justify-between items-center mb-2">
    <h2 class="font-semibold">
      <%= form_tag book_planner_path, method: :get, class: "inline-flex gap-2 items-center" do %>
        <%= select_month @month, prefix: nil, field_name: "month", class: "form-select form-select-sm" %>
        <%= select_year @year, prefix: nil, field_name: "year", start_year: @year - 1, end_year: @year + 5, class: "form-select form-select-sm" %>
        <%= submit_tag "Go", class: "bg-blue-500 text-white px-2 py-1 rounded text-sm" %>
      <% end %>
    </h2>
    <% if @monthly_plan.persisted? %>
      <% if @books.any? %>
        <%= form_tag monthly_plan_planned_books_path(@monthly_plan), class: "flex gap-2 items-end" do %>
          <%= select_tag :book_id, options_from_collection_for_select(@books, :id, :title), include_blank: "Add book...", class: "form-select form-select-sm" %>
          <%= submit_tag "+", class: "bg-green-500 text-white px-2 py-1 rounded text-sm" %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% if @monthly_plan.persisted? %>
    <% if @planned_books.any? %>
      <table class="table table-sm mb-3">
        <thead>
          <tr>
            <th>#</th>
            <th>Book</th>
            <th>Author</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @planned_books.each_with_index do |pb, idx| %>
            <tr>
              <td class="align-middle"><%= pb.position + 1 %></td>
              <td class="align-middle"><%= pb.book.title %></td>
              <td class="align-middle text-gray-600"><%= pb.book.author %></td>
              <td class="align-middle text-nowrap">
                <% if idx > 0 %>
                  <%= button_to "↑", move_up_monthly_plan_planned_book_path(@monthly_plan, pb), method: :patch, class: "btn btn-sm btn-outline-secondary py-0 px-1" %>
                <% end %>
                <% if idx < @planned_books.size - 1 %>
                  <%= button_to "↓", move_down_monthly_plan_planned_book_path(@monthly_plan, pb), method: :patch, class: "btn btn-sm btn-outline-secondary py-0 px-1" %>
                <% end %>
                <%= link_to "Remove", monthly_plan_planned_book_path(@monthly_plan, pb), data: { turbo_method: :delete, turbo_confirm: "Remove from plan?" }, class: "text-red-600 text-sm ms-1" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <%# Weekly Breakdown %>
      <div class="mt-3 pt-3 border-t">
        <h3 class="font-medium text-sm mb-2">Weekly Breakdown</h3>
        <div class="grid grid-cols-4 gap-2">
          <% @weeks.each do |week| %>
            <div class="border rounded p-2">
              <p class="text-xs font-semibold mb-1">Week <%= week[:week] %></p>
              <% week[:planned_books].each do |pb| %>
                <% log = @reading_logs[pb.book_id] %>
                <div class="border-b border-gray-100 last:border-b-0 py-1">
                  <div class="flex items-center justify-between gap-1">
                    <span class="text-xs truncate"><%= pb.book.title %></span>
                    <% if log&.finish_date.present? %>
                      <span class="text-xs text-green-600 font-medium shrink-0">✓</span>
                    <% elsif log&.start_date.present? %>
                      <span class="text-xs text-blue-600 shrink-0">Reading</span>
                    <% else %>
                      <%= button_to reading_logs_path, params: { reading_log: { book_id: pb.book_id, start_date: Date.current } }, class: "text-xs bg-green-500 text-white px-1.5 py-0.5 rounded shrink-0" do %>
                        Start
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="text-gray-500 text-sm">No books planned for this month. Add books from your catalog above.</p>
    <% end %>
  <% else %>
    <%= form_tag monthly_plans_path, method: :post, class: "inline" do %>
      <%= hidden_field_tag "monthly_plan[year]", @year %>
      <%= hidden_field_tag "monthly_plan[month]", @month %>
      <%= submit_tag "Start Planning #{Date::MONTHNAMES[@month]}", class: "bg-green-500 text-white px-3 py-1 rounded text-sm" %>
    <% end %>
  <% end %>
</div>

<%# Reading Logs %>
<div class="border rounded p-4 mb-4">
  <h2 class="font-semibold mb-2">Reading Progress</h2>
  <% if @books.any? %>
    <div class="space-y-3">
      <% @books.each do |book| %>
        <% log = @reading_logs[book.id] %>
        <div class="border rounded p-3">
          <div class="flex justify-between items-center mb-2">
            <span class="font-medium"><%= book.title %></span>
            <% if log&.finish_date.present? %>
              <span class="text-green-600 text-sm font-medium">Finished</span>
            <% elsif log&.start_date.present? %>
              <span class="text-blue-600 text-sm font-medium">Reading</span>
            <% end %>
          </div>
          <%= form_with model: log || ReadingLog.new, url: log ? reading_log_path(log) : reading_logs_path, class: "flex flex-wrap gap-2 items-end" do |f| %>
            <%= f.hidden_field :book_id, value: book.id %>
            <div>
              <%= f.label :start_date, "Start", class: "text-xs" %>
              <%= f.date_field :start_date, class: "form-control form-control-sm" %>
            </div>
            <div>
              <%= f.label :finish_date, "Finish", class: "text-xs" %>
              <%= f.date_field :finish_date, class: "form-control form-control-sm" %>
            </div>
            <div>
              <%= f.label :rating, "Rating", class: "text-xs" %>
              <%= f.select :rating, options_for_select([["", nil]] + (1..5).map { |r| [r, r] }, log&.rating), {}, class: "form-select form-select-sm" %>
            </div>
            <div>
              <%= f.label :notes, "Notes", class: "text-xs" %>
              <%= f.text_field :notes, value: log&.notes, class: "form-control form-control-sm" %>
            </div>
            <%= f.submit log&.persisted? ? "Update" : "Log", class: "bg-blue-500 text-white px-2 py-1 rounded text-sm" %>
            <% if log&.persisted? %>
              <%= link_to "Delete", reading_log_path(log), data: { turbo_method: :delete, turbo_confirm: "Remove log?" }, class: "text-red-600 text-sm" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-sm">Add books first to track your reading progress.</p>
  <% end %>
</div>
